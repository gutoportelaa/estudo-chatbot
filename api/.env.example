# Banco de dados PostgreSQL
# docker-compose mapeia 5433:5432 — use 5433 no host local
DATABASE_URL=postgresql+asyncpg://thinkai:thinkai@localhost:5433/thinkai

# ── Provedor LLM ────────────────────────────────────────────────────────────
# Opções: gemini | groq | openrouter | ollama
LLM_PROVIDER=ollama
# Modelo override (vazio = usa o padrão do provedor abaixo)
LLM_MODEL=

# Google Gemini (obtenha em aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq — fallback de produção (obtenha em console.groq.com)
GROQ_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Ollama — rodando localmente, sem chave necessária
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# ── Autenticação JWT ────────────────────────────────────────────────────────
# Gere: openssl rand -hex 32
SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=1440

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── System prompt ──────────────────────────────────────────────────────────
SYSTEM_PROMPT=Você é o ThinkAI, um assistente prestativo, claro e conciso. Atue como um assistente de estudos sobre a área de interesse do usuário, recomendando questões, referências e respondendo a dúvidas. Responda no mesmo idioma da pergunta.

# ── Gestão de histórico (janela deslizante + sumarização híbrida) ───────────
# hybrid | window | off
HISTORY_STRATEGY=hybrid
HISTORY_WINDOW_MESSAGES=12
HISTORY_SUMMARIZE_AFTER_MESSAGES=6
HISTORY_SUMMARY_MAX_TOKENS=600
# Modelo para sumarizar (vazio = mesmo do chat)
SUMMARIZER_MODEL=

# ── Armazenamento de documentos (PDFs) ─────────────────────────────────────
# local (dev/filesystem) | s3 (produção)
STORAGE_BACKEND=local
STORAGE_DIR=./data/documents
MAX_UPLOAD_MB=50
# S3 — preencha só se STORAGE_BACKEND=s3
S3_BUCKET=thinkai-pdfs-<seu-nome>
S3_REGION=us-east-1
PRESIGN_EXPIRE_SECONDS=900
